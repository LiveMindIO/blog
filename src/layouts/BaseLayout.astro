---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "LiveMindIO Field Notes",
  description = "Field notes on experimental media, audience interaction, and the systems behind them.",
  image = "/social-card.svg",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === "LiveMindIO Field Notes" ? title : `${title} | LiveMindIO`;
const currentPath = Astro.url.pathname;
const postModules = import.meta.glob<{ frontmatter: { title: string; published: string }; url: string }>(
  "../content/posts/*.md",
  { eager: true },
);
const sidebarPosts = Object.values(postModules).sort(
  (a, b) => Date.parse(a.frontmatter.published) - Date.parse(b.frontmatter.published),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="LiveMindIO Field Notes" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-main">
      <aside id="app-sidebar" class="app-sidebar" aria-label="Field notes navigation">
        <a class="app-sidebar-header" href="/">
          <span class="app-brand-mark" aria-hidden="true">LM</span>
          <span class="app-brand-copy"><strong>Blog</strong><span>LiveMindIO</span></span>
        </a>
        <button id="app-sidebar-close" class="app-sidebar-close" type="button" aria-label="Close navigation">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
        </button>
        <nav class="app-sidebar-menu" aria-label="Blog pages">
          <section class="side-nav-group" aria-labelledby="side-nav-posts">
            <h2 id="side-nav-posts" class="side-nav-heading">Blog Posts</h2>
            <ul class="side-nav-list">
              <li><a class="side-nav-link" href="/" aria-current={currentPath === "/" ? "page" : undefined}>Overview</a></li>
              {sidebarPosts.map((post) => (
                <li><a class="side-nav-link" href={post.url} aria-current={currentPath === post.url ? "page" : undefined}>{post.frontmatter.title}</a></li>
              ))}
            </ul>
          </section>
        </nav>
      </aside>
      <div class="app-wrapper">
        <header class="app-header">
          <button id="app-sidebar-toggle" class="app-sidebar-toggle" type="button" aria-controls="app-sidebar" aria-expanded="false" aria-label="Open navigation">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
          </button>
          <nav class="top-nav" aria-label="Primary navigation">
            <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>Home</a>
            <a href="https://dashboard.livemind.io/overview.html">Super Slop Bots</a>
            <a href="https://github.com/LiveMindIO">GitHub</a>
            <a href="https://dashboard.livemind.io/contact.html">Contact Us</a>
          </nav>
          <span class="header-spacer" aria-hidden="true"></span>
        </header>
        <div class="app-content-wrapper">
          <main id="main-content" tabindex="-1">
            <slot />
          </main>
        </div>
        <footer class="site-footer">
          <div class="content-shell footer-grid">
            <p><strong>LiveMindIO</strong><br />Experimental media shaped by its audience.</p>
            <p class="post-meta">Built in public.<br />Observed in production.</p>
          </div>
        </footer>
      </div>
      <button id="app-backdrop" class="app-backdrop" type="button" aria-label="Close navigation"></button>
    </div>
    <script>
      const body = document.body;
      const toggle = document.querySelector("#app-sidebar-toggle");
      const close = document.querySelector("#app-sidebar-close");
      const backdrop = document.querySelector("#app-backdrop");
      const setOpen = (open: boolean) => {
        body.classList.toggle("sidebar-open", open);
        toggle?.setAttribute("aria-expanded", String(open));
      };
      toggle?.addEventListener("click", () => setOpen(!body.classList.contains("sidebar-open")));
      close?.addEventListener("click", () => setOpen(false));
      backdrop?.addEventListener("click", () => setOpen(false));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setOpen(false);
      });
    </script>
  </body>
</html>
